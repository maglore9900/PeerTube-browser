# No trailing slash: worktrees hold these as symlinks, which a dir-only pattern misses.
node_modules
*.log
.DS_Store
venv/
__pycache__/
*.pyc
.env

# Local data files
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.building
*.db.bak
*.db.bak-*
*.faiss
*.faiss.json
# Blue/green deploy flock (scripts/deploy-bluegreen.sh, updater-worker.py); not covered by *.db*.
engine/server/db/engine-deploy.lock
# Runtime pid files of the local Engine/Client; committing them conflicts on every merge.
*.pid
/.cache/
/.tmp/
/tmp
/dev/nginx

client/frontend/run-client-sync-build.sh
client/frontend/run-client-sync-build-client-dev.sh
client/frontend/dev-pages/*
!client/frontend/dev-pages/about.template.html
.claude/
.un/
.un/

.pixi
pixi*

.un/oauth/
