@@ -4,6 +4,9 @@ from __future__ import annotations
 
 import sqlite3
 
+# The schema name a trending ranks override file is attached under.
+TRENDING_OVERRIDE_SCHEMA = "trending_override"
+
 
 def ensure_trending_schema(conn: sqlite3.Connection) -> None:
     """Create the table of each catalogue host's own trending list and the index the Trending order walks."""
@@ -23,3 +26,25 @@ def ensure_trending_schema(conn: sqlite3.Connection) -> None:
           ON trending_ranks (rank ASC, likes DESC, views DESC, video_id DESC, instance_domain DESC);
         """
     )
+
+
+def prepare_trending_override(path: str) -> None:
+    """Check that an existing SQLite file is at `path` and apply the trending schema to it, exiting with a message naming the path otherwise."""
+    # rat-tail: `path` is not URI-escaped, so one holding `?` or `#` fails here instead of opening; urllib.parse.quote it if that matters.
+    # mode=rw never creates the file, as connect_readonly_db's mode=ro does not; a file that is not SQLite fails on the schema statement.
+    try:
+        conn = sqlite3.connect(f"file:{path}?mode=rw", uri=True)
+        try:
+            ensure_trending_schema(conn)
+        finally:
+            conn.close()
+    except sqlite3.Error as exc:
+        raise SystemExit(f"trending ranks file {path} cannot be opened as SQLite: {exc}") from exc
+
+
+def attach_trending_override(conn: sqlite3.Connection, path: str) -> None:
+    """Make every unqualified trending_ranks read on `conn` read the table in the file at `path`; call it outside a transaction."""
+    # rat-tail: on a non-URI connection ATTACH creates a missing file, so a file removed after prepare_trending_override comes back empty; a URI connection with mode=rw closes that gap.
+    conn.execute(f"ATTACH DATABASE ? AS {TRENDING_OVERRIDE_SCHEMA}", (path,))
+    # Names resolve temp, then main, then attached, so a bare ATTACH leaves main.trending_ranks in front; this TEMP view shadows it, and SQLite flattens it so the Trending page still walks idx_trending_ranks_order.
+    conn.execute(f"CREATE TEMP VIEW trending_ranks AS SELECT * FROM {TRENDING_OVERRIDE_SCHEMA}.trending_ranks")
