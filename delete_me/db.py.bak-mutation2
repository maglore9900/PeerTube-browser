"""Provide db runtime helpers."""

from __future__ import annotations

import sqlite3
import threading
import time
from collections.abc import Iterator
from contextlib import contextmanager
from pathlib import Path

# SQLite VM instructions between progress-handler callbacks. Small enough that the
# deadline is honoured promptly, large enough that the callback overhead is noise.
PROGRESS_HANDLER_INSTRUCTIONS = 10_000


# The running thread's deadline, as `time.monotonic()` seconds; absent or None means none.
_deadline = threading.local()


def _deadline_passed() -> int:
    """Progress handler: abort the running statement once its own thread's deadline passes.

    SQLite calls it on the thread stepping the statement, so a deadline set by one request
    thread never reaches a statement another thread runs on the same connection.
    """
    at = getattr(_deadline, "at", None)
    return 1 if at is not None and time.monotonic() > at else 0


def install_deadline_handler(conn: sqlite3.Connection) -> None:
    """Install the progress handler `statement_deadline` relies on. Call once, at open.

    The handler is never changed afterwards, and that is the point: calling
    `set_progress_handler` while another thread's statement is running on the connection
    deadlocks the process. The installer holds the GIL while it waits for the connection's
    mutex, and the running statement needs the GIL to call its handler.

    :param conn: Connection whose statements `statement_deadline` should bound.
    """
    conn.set_progress_handler(_deadline_passed, PROGRESS_HANDLER_INSTRUCTIONS)


@contextmanager
def statement_deadline(seconds: float) -> Iterator[None]:
    """Interrupt this thread's statements that are still running after `seconds`.

    SQLite offers no statement timeout; the progress handler is the only cancellation
    point, and it aborts the running statement with `sqlite3.OperationalError: interrupted`.
    Only connections carrying `install_deadline_handler` are bounded. The block touches no
    connection, so it is safe to enter while other threads' statements run, and it restores
    the thread's previous deadline on exit so a nested block leaves the outer one intact.

    :param seconds: Wall-clock budget; non-positive disables the guard.
    """
    if seconds <= 0:
        yield
        return
    previous = getattr(_deadline, "at", None)
    _deadline.at = time.monotonic() + seconds
    try:
        yield
    finally:
        _deadline.at = previous


def is_interrupted_error(exc: sqlite3.OperationalError) -> bool:
    """Report whether `exc` is the abort raised by a tripped progress handler.

    :param exc: Error raised out of a statement executed under `statement_deadline`.
    :returns: True when the statement was cancelled rather than failing on its own.
    """
    return "interrupted" in str(exc).lower()


def connect_db(path: Path) -> sqlite3.Connection:
    """Open the crawl database for shared reads and writes."""
    conn = sqlite3.connect(path.as_posix(), check_same_thread=False)
    conn.row_factory = sqlite3.Row
    install_deadline_handler(conn)
    return conn


def connect_readonly_db(path: Path) -> sqlite3.Connection:
    """Open a second, read-only handle on the same database file.

    For statements long enough that running them under the shared connection's lock would
    stall every other route.
    """
    uri = f"file:{path.as_posix()}?mode=ro"
    conn = sqlite3.connect(uri, uri=True, check_same_thread=False)
    conn.row_factory = sqlite3.Row
    install_deadline_handler(conn)
    return conn


def connect_user_db(path: Path) -> sqlite3.Connection:
    """Open or create the users database."""
    conn = sqlite3.connect(path.as_posix(), check_same_thread=False)
    conn.row_factory = sqlite3.Row
    return conn


def connect_similarity_db(path: Path) -> sqlite3.Connection:
    """Open the similarity cache database."""
    conn = sqlite3.connect(path.as_posix(), check_same_thread=False)
    conn.row_factory = sqlite3.Row
    return conn
