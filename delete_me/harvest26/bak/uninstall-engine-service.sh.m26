#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="${PROJECT_DIR:-$SCRIPT_DIR/..}"
# shellcheck source=engine-upstream.sh
source "${SCRIPT_DIR}/engine-upstream.sh"

MODE="prod"
ENGINE_SERVICE_NAME=""
DRY_RUN=0

print_usage() {
  cat <<'EOF_USAGE'
Usage: sudo ./engine/uninstall-engine-service.sh [options]

Uninstall Engine systemd service for prod/dev contour.
prod: stops and disables peertube-engine@7070/@7071, removes the template peertube-engine@.service
(and a legacy peertube-engine.service), the nginx listener, then the upstream snippet, and re-validates nginx.

Options:
  --mode <prod|dev>         Contour mode (default: prod)
  --project-dir <path>      Project root path (accepted for symmetry)
  --service-name <name>     Override Engine unit base name (default: peertube-engine[-dev]; prod: fixed peertube-engine)
  --dry-run                 Print planned actions without changing system files
  -h, --help                Show this help
EOF_USAGE
}

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1"
}

log_lifecycle() {
  local message="$1"
  echo "${message}"
  if command -v logger >/dev/null 2>&1; then
    logger -t peertube-service-lifecycle "${message}" || true
  fi
}

validate_mode() {
  case "${MODE}" in
    prod|dev) ;;
    *) fail "Invalid --mode: ${MODE} (expected prod|dev)" ;;
  esac
}

validate_service_name() {
  local name="$1"
  [[ -n "${name}" ]] || fail "Service name cannot be empty"
  [[ "${name}" =~ ^[a-zA-Z0-9_.@-]+$ ]] || fail "Invalid service name: ${name}"
}

quoted_cmd() {
  local out=""
  local arg
  for arg in "$@"; do
    out+="$(printf '%q' "${arg}") "
  done
  printf '%s' "${out% }"
}

run_cmd() {
  if (( DRY_RUN == 1 )); then
    echo "[dry-run] $(quoted_cmd "$@")"
    return 0
  fi
  "$@"
}

# stop/disable lines keep stdout so their [dry-run] echo shows; only systemctl's complaints about absent units are dropped.
uninstall_engine_prod() {
  local template_path="/etc/systemd/system/${ENGINE_INSTANCE_BASE}@.service"
  local legacy_path="/etc/systemd/system/${ENGINE_INSTANCE_BASE}.service"
  local unit

  if (( DRY_RUN == 1 )); then
    echo "[dry-run] uninstall-engine-service"
    echo "  mode=${MODE}"
    echo "  service=${ENGINE_INSTANCE_BASE}@ (template; instances @7070 @7071)"
    echo "  unit=${template_path}"
    echo "  legacy_unit=${legacy_path}"
    echo "  listener=${ENGINE_LISTENER_CONF}"
    echo "  snippet=${UPSTREAM_SNIPPET}"
  else
    [[ "${EUID}" -eq 0 ]] || fail "Run as root (use sudo)."
    require_cmd systemctl
  fi

  log_lifecycle "[engine-uninstall] begin service=${ENGINE_INSTANCE_BASE}@ mode=${MODE}"
  # The legacy single unit too, so an un-migrated host uninstalls cleanly.
  for unit in "${ENGINE_INSTANCE_BASE}@${ENGINE_INSTANCE_PORTS[0]}.service" "${ENGINE_INSTANCE_BASE}@${ENGINE_INSTANCE_PORTS[1]}.service" "${ENGINE_INSTANCE_BASE}.service"; do
    log_lifecycle "[engine-uninstall] stopping service=${unit}"
    run_cmd systemctl stop "${unit}" 2>/dev/null || true
    log_lifecycle "[engine-uninstall] disabling service=${unit}"
    run_cmd systemctl disable "${unit}" 2>/dev/null || true
  done
  run_cmd rm -f "${template_path}" "${legacy_path}"
  # The listener includes the snippet, so it goes first; the other order fails nginx -t.
  run_cmd rm -f "${ENGINE_LISTENER_CONF}"
  run_cmd rm -f "${UPSTREAM_SNIPPET}" "${UPSTREAM_SNIPPET}.bak"

  if (( DRY_RUN == 0 )); then
    systemctl daemon-reload
    systemctl reset-failed "${ENGINE_INSTANCE_BASE}@*" "${ENGINE_INSTANCE_BASE}.service" >/dev/null 2>&1 || true
  fi

  if command -v nginx >/dev/null 2>&1; then
    run_cmd nginx -t || fail "nginx -t failed after removing ${ENGINE_LISTENER_CONF}; nginx was not reloaded."
    run_cmd systemctl reload nginx
  else
    log_lifecycle "[engine-uninstall] nginx not found; skipped nginx -t and reload"
  fi

  echo "Engine service removed: ${ENGINE_INSTANCE_BASE}@7070/@7071 and ${template_path}"
  echo "Left in place: $(engine_deploy_lock_path "${PROJECT_DIR}") and any drop-ins under ${template_path}.d/"
  log_lifecycle "[engine-uninstall] removed service=${ENGINE_INSTANCE_BASE}@ mode=${MODE}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      MODE="${2:-}"
      shift 2
      ;;
    --project-dir)
      PROJECT_DIR="${2:-}"
      shift 2
      ;;
    --service-name)
      ENGINE_SERVICE_NAME="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

validate_mode
PROJECT_DIR="$(realpath "${PROJECT_DIR}")"
[[ -d "${PROJECT_DIR}" ]] || fail "Project directory not found: ${PROJECT_DIR}"

if [[ -z "${ENGINE_SERVICE_NAME}" ]]; then
  if [[ "${MODE}" == "prod" ]]; then
    ENGINE_SERVICE_NAME="${ENGINE_INSTANCE_BASE}"
  else
    ENGINE_SERVICE_NAME="peertube-engine-dev"
  fi
fi
validate_service_name "${ENGINE_SERVICE_NAME}"

if [[ "${MODE}" == "prod" ]]; then
  [[ "${ENGINE_SERVICE_NAME}" == "${ENGINE_INSTANCE_BASE}" ]] || fail "--service-name is fixed to ${ENGINE_INSTANCE_BASE} in --mode prod (instances ${ENGINE_INSTANCE_BASE}@7070 and @7071)"
  uninstall_engine_prod
  exit 0
fi

UNIT_PATH="/etc/systemd/system/${ENGINE_SERVICE_NAME}.service"

if (( DRY_RUN == 1 )); then
  echo "[dry-run] uninstall-engine-service"
  echo "  mode=${MODE}"
  echo "  service=${ENGINE_SERVICE_NAME}"
  echo "  unit=${UNIT_PATH}"
fi

if (( DRY_RUN == 0 )); then
  [[ "${EUID}" -eq 0 ]] || fail "Run as root (use sudo)."
  require_cmd systemctl
fi

log_lifecycle "[engine-uninstall] begin service=${ENGINE_SERVICE_NAME}.service mode=${MODE}"
log_lifecycle "[engine-uninstall] stopping service=${ENGINE_SERVICE_NAME}.service"
run_cmd systemctl stop "${ENGINE_SERVICE_NAME}.service" >/dev/null 2>&1 || true
log_lifecycle "[engine-uninstall] disabling service=${ENGINE_SERVICE_NAME}.service"
run_cmd systemctl disable "${ENGINE_SERVICE_NAME}.service" >/dev/null 2>&1 || true
run_cmd rm -f "${UNIT_PATH}"

if (( DRY_RUN == 0 )); then
  systemctl daemon-reload
  systemctl reset-failed "${ENGINE_SERVICE_NAME}.service" >/dev/null 2>&1 || true
fi

echo "Engine service removed: ${ENGINE_SERVICE_NAME}.service"
log_lifecycle "[engine-uninstall] removed service=${ENGINE_SERVICE_NAME}.service mode=${MODE}"
