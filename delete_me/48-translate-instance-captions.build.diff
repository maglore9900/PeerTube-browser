+    "spanning a second line\r\n"
+    "\r\n"
+    "STYLE\r\n"
+    "::cue { color: yellow }\r\n"
+    "\r\n"
+    "REGION\r\n"
+    "id:bottom width:40%\r\n"
+    "\r\n"
+    "cue-2\r\n"
