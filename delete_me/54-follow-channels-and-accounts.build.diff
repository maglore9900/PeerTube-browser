+# --- the Following read through the gateway: the stored follows go to the Engine in place of likes, and the page comes back filtered, uncut, with its cursor ---
+
+
+HOST = "g.example"
+PAGE = 3
+FOLLOWING = f"/recommendations?mode=following&limit={PAGE}"
+# Opaque to the gateway; URL-safe, as the Engine's base64url cursors are.
+STUB_CURSOR = "WzE3MDAwMDAwMDAwMDAsInYiLCJnIl0"
