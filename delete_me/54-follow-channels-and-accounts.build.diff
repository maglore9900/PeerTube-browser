++@contextmanager
++def _serving(srv):
++    thread = threading.Thread(target=srv.serve_forever, daemon=True)
++    thread.start()
++    try:
++        yield f"http://127.0.0.1:{srv.server_address[1]}"
++    finally:
++        srv.shutdown()
++        srv.server_close()
++
