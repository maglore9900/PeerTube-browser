+import re
+import sys
+
+# Collapse runs of three or more blank lines to two, so appended blocks keep PEP 8's two-line spacing.
+text = open(sys.argv[1]).read()
+sys.stdout.write(re.sub(r"\n{4,}", "\n\n\n", text))
