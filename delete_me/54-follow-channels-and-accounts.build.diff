+MAIN_PAGES = [["A3", "X2", "X1", "TB"], ["TA", "BZ", "AM", "X0"], ["A1"]]
+NSFW_PAGES = [["NSF", "A3", "X2", "X1"], ["TB", "TA", "BZ", "AM"], ["X0", "A1"]]
+MODERATION_FOLLOWS = {"channels": [["a.example", "ch-a"], ["m.example", "ch-m"]], "accounts": []}
