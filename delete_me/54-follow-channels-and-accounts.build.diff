+-"""Read-only: time a newest-first page over a set of followed sources with today's indexes.
++"""AC8: time Following pages with the product read (`fetch_followed_page`) on a copy of the dev whitelist.db that has the two recency indexes.
+ 
+-Picks followed sets from the catalogue (small channels, big channels, multi-channel accounts)
+-and runs the query the Following mode would need, with and without a cursor. whitelist.db has
+-no index on channel_id or account_url, so this measures the no-new-index case only.
++Run from the repository root under the Engine interpreter, with the dev Engine stopped or idle:
++
++    engine/.pixi/envs/default/bin/python .scratch/follow-channels-and-accounts/following_query_timing.py [copy path]
++
++Copies engine/server/db/whitelist.db to the copy path (default /tmp/following-timing.db), times and sizes `ensure_video_indexes` on the copy, then for five followed sets fixed by a seed times the first page, the next page from its cursor and a last page (a cursor past every row), each warm, best of 5, and prints one batch's EXPLAIN QUERY PLAN. The source is opened read-only and never written.
+ """
++import json
++import os
++import random
+ import sqlite3
++import sys
+ import time
++from pathlib import Path
++
++ROOT = Path(__file__).resolve().parents[2]
++sys.path.insert(0, str(ROOT / "engine" / "server"))
++# data.metadata imports `recommendations`, which lives under engine/server/api, as server.py sets up.
++sys.path.insert(0, str(ROOT / "engine" / "server" / "api"))
++from data.random_videos import decode_followed_cursor, fetch_followed_page  # noqa: E402
++from data.videos import ensure_video_indexes  # noqa: E402
++
++SOURCE = ROOT / "engine" / "server" / "db" / "whitelist.db"
++COPY = Path(sys.argv[1] if len(sys.argv) > 1 else "/tmp/following-timing.db")
++PAGE = 48
++THRESHOLD = 3
++RUNS = 5
++SEED = 54
++# A cursor older than every dated row: each term seeks to the end of its range, the cost of a last page or a quiet source.
++PAST_EVERY_ROW = (0, "", "")
+ 
+-conn = sqlite3.connect("file:engine/server/db/whitelist.db?mode=ro", uri=True)
+ 
++class Recorder:
++    """A connection stand-in that keeps the last statement fetch_followed_page ran, for EXPLAIN."""
+ 
+-def pick(sql, n):
+-    return [tuple(r) for r in conn.execute(sql, (n,))]
++    def __init__(self, conn):
++        self.conn = conn
