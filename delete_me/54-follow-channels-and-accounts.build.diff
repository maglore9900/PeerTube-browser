+_TRENDING_HANDLER_CHILD = textwrap.dedent(
+    """
+    import io, json, sqlite3, sys, threading, types
+    sys.path[:0] = [sys.argv[1], sys.argv[2]]
+    from handlers import similar
+    from request_context import set_request_excluded_keys
