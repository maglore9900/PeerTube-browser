+    "X1": ("x1", "x.example", "ch-x1", ACCT_X, 7000, 0, 0, True),
+    "TB": ("v-tie", "b.example", "ch-b", ACCT_B, 6000, 0, 0, True),
+    "TA": ("v-tie", "a.example", "ch-a", ACCT_A, 6000, 0, 0, True),
