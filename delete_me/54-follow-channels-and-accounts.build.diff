+    "A2": ("v-m", "a.example", 2, 10, 10, 0, 0, True, True),
+    "E": ("v-a", "d.example", 2, 10, 10, 0, TRENDING_THRESHOLD, True, True),
+    "A3": ("a3", "a.example", 3, 500, 5000, 0, 0, True, True),
