// PROBE ONLY — wrong implementation, reverted after the run.
import { resolveClientApiBase } from "./api-base";

const K = "profileKey:v1";

export function getProfileKey(): string | null {
  return localStorage.getItem(K);
}

export function profileHeaders(): Record<string, string> {
  const k = getProfileKey();
  return k ? { "x-profile-key": k } : {};
}

export async function createProfile(apiBase: string): Promise<string> {
  const r = await fetch(new URL("/api/profile", resolveClientApiBase(apiBase)), { method: "POST" });
  const b = await r.json();
  localStorage.setItem(K, b.key);
  return b.key;
}

export function storeProfileKey(key: string): void {
  localStorage.setItem(K, key);
}

export async function rotateProfileKey(apiBase: string): Promise<string> {
  const r = await fetch(new URL("/api/profile/rotate", resolveClientApiBase(apiBase)), {
    method: "POST",
    headers: profileHeaders()
  });
  return (await r.json()).key; // wrong: the new key is not stored
}

export async function deleteProfile(_apiBase: string): Promise<void> {
  localStorage.removeItem(K);
}
