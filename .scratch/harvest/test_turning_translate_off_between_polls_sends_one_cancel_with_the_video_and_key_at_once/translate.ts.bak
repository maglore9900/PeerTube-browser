/**
 * Module `client/frontend/src/pages/video-page/translate.ts`: the Translate toggle and the English line shown over the embedded player.
 *
 * One PeerTubePlayer is built per page, on #video-embed, right after its api=1 src is set. A second one on the same iframe window throws, and destroy() removes the iframe, so neither is ever done. The toggle shows only once the embed API's `ready` resolved and a profile key is held; before that no translate request is made. The on-load path and the click path are the same turnOn, so a page loaded with Translate on behaves like a click.
 *
 * Each `none` state from a serving worker (`available`), at turn-on or from the poll, is followed by one generation request. While the job is queued or running a state poll, separate from the position poll, asks again with backoff, sending the count of running cues held as `after` and merging the new ones in; it ends on any other state, an answer without `available`, a 401, or turnOff. turnOff sends one cancel, after every translate request already in flight has settled.
 */

import { PeerTubePlayer } from "@peertube/embed-api";
import { getProfileKey, ProfileKeyRejectedError } from "../../data/profile";
import { cancelTranslate, compareCues, fetchTranslate, readTranslate, requestTranslate, setTranslate, type TranslateCue, type TranslateRequestState, type TranslateState } from "../../data/translate";

export type TranslateVideo = { id: string; host: string };

const toggleEl = document.getElementById("translate-toggle") as HTMLButtonElement | null;
const statusEl = document.getElementById("translate-status");
const overlayEl = document.getElementById("translate-overlay");
const NO_TRANSLATION = "No English translation is available for this video.";
const WAITING = "Waiting for translation…";
const TRANSLATING = "Translating…";
const BUSY = "The translation queue is full. Turn Translate off and on to try again.";
const ENDED_LABELS: Record<"none" | "already_english" | "failed", string> = {
  none: NO_TRANSLATION,
  already_english: "This video is already in English.",
  failed: "Translation failed for this video."
};
// The embed's playbackStatusUpdate is the clock; getCurrentPosition is polled only after this much silence.
const POLL_AFTER_SILENCE_MS = 3000;
const POLL_INTERVAL_MS = 1000;
// The state poll doubles its wait while nothing changes and resets on any change, so a job queued behind another stays cheap.
const STATE_POLL_FIRST_MS = 2000;
const STATE_POLL_MAX_MS = 16000;

let started = false;
let player: PeerTubePlayer | null = null;
let on = false;
let cues: TranslateCue[] = [];
// Bumped by every turn-on and turn-off, so the reply to an earlier request is dropped.
let requestTicket = 0;
let lastUpdateAt = 0;
let pollTimer: ReturnType<typeof setInterval> | null = null;
let pollInFlight = false;
let stateTimer: ReturnType<typeof setTimeout> | null = null;
let stateDelay = STATE_POLL_FIRST_MS;
let lastState = "";
// The running cues held, sent as after so each poll brings only the new ones.
let runningHeld = 0;
// Settles once every translate request sent so far has, so turnOff's cancel reaches the gateway after them and not before a poll it would then answer.
let requestsSettled: Promise<void> = Promise.resolve();

/**
 * The embed URL with api=1 set, correct with or without an existing query; null when it does not parse.
 */
export function withEmbedApi(embed: string): string | null {
  try {
    const url = new URL(embed.trim());
    url.searchParams.set("api", "1");
    return url.href;
  } catch {
    return null;
  }
}

/**
 * Bind the embed API to the iframe once per page and show the toggle when it answers; never throws.
 */
export function setupTranslate(iframe: HTMLIFrameElement, apiBase: string, video: TranslateVideo): void {
  if (started || !toggleEl || !overlayEl) return;
  started = true;
  let created: PeerTubePlayer;
  try {
    created = new PeerTubePlayer(iframe);
  } catch {
    // jschannel throws strings, not Errors, when this window or the iframe cannot post messages; the page works on with no toggle.
    return;
  }
  // A rejected ready is caught here, so it never surfaces as an unhandled rejection; one that never settles leaves the toggle hidden.
  created.ready.then(() => onReady(created, apiBase, video), () => undefined);
}

/**
 * Binary-search cues sorted by start for the latest-started cue, and return it when it contains position.
 */
function findCue(sorted: TranslateCue[], position: number): TranslateCue | null {
  let low = 0;
  let high = sorted.length - 1;
  let found = -1;
  while (low <= high) {
    const mid = (low + high) >> 1;
    if (sorted[mid].start <= position) {
      found = mid;
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }
  const cue = found >= 0 ? sorted[found] : null;
  return cue && position < cue.end ? cue : null;
}

function onReady(ready: PeerTubePlayer, apiBase: string, video: TranslateVideo) {
  if (!toggleEl || !getProfileKey() || !video.id || !video.host) return;
  player = ready;
  // Subscribed once and never removed; updates are ignored while Translate is off.
  ready.addEventListener("playbackStatusUpdate", (status: unknown) => {
    lastUpdateAt = Date.now();
    showAt(finiteNumber((status as { position?: unknown } | null)?.position));
  });
  toggleEl.addEventListener("click", () => {
    if (on) turnOff(apiBase, video);
    else void turnOn(apiBase, video);
  });
  renderToggle();
  toggleEl.hidden = false;
  if (readTranslate()) void turnOn(apiBase, video);
}

async function turnOn(apiBase: string, video: TranslateVideo) {
  on = true;
  setTranslate(true);
  renderToggle();
  setStatus("Loading translation…");
  resetStatePoll();
  const ticket = ++requestTicket;
  try {
    const state = await tracked(fetchTranslate(apiBase, video.id, video.host));
    if (ticket !== requestTicket) return;
    await applyFetched(state, apiBase, video, ticket);
  } catch (error) {
    if (ticket !== requestTicket) return;
    setStatus(error instanceof Error ? error.message : "Could not load the translation");
  }
}

function turnOff(apiBase: string, video: TranslateVideo) {
  on = false;
  requestTicket += 1;
  resetStatePoll();
  setTranslate(false);
  stopPolling();
  renderToggle();
  setStatus("");
  showText("");
  // A failed cancel only leaves the viewer lease to run out on its own, and the page, now off, has no status to show it in.
  void requestsSettled.then(() => cancelTranslate(apiBase, video.id, video.host)).catch(() => undefined);
}

function tracked<T>(request: Promise<T>): Promise<T> {
  // Resolved to undefined so the chain does not nest every earlier answer.
  requestsSettled = Promise.allSettled([requestsSettled, request]).then(() => undefined);
  return request;
}

// Only a none from a serving worker asks for generation; without one the page answers as plan 48 did.
async function applyFetched(state: TranslateState, apiBase: string, video: TranslateVideo, ticket: number) {
  if (state.state === "none" && state.available) {
    // Recorded so the queued answer to this request reads as a change and the poll restarts its backoff for the new job.
    lastState = state.state;
    const requested = await tracked(requestTranslate(apiBase, video.id, video.host));
    if (ticket !== requestTicket) return;
    applyRequest(requested, apiBase, video, ticket);
    return;
  }
  applyState(state, apiBase, video, ticket);
}

function applyRequest(requested: TranslateRequestState, apiBase: string, video: TranslateVideo, ticket: number) {
  if (requested.state === "busy") {
    setStatus(BUSY);
    return;
  }
  // An existing ready or running job is answered without its cues, so the state route is read at once.
  if (requested.state === "ready" || requested.state === "running") {
    scheduleStatePoll(apiBase, video, ticket, 0);
    return;
  }
  applyState({ state: requested.state, available: requested.available }, apiBase, video, ticket);
}

function applyState(state: TranslateState, apiBase: string, video: TranslateVideo, ticket: number) {
  let changed = state.state !== lastState;
  lastState = state.state;
  if (state.state === "ready") {
    runningHeld = 0;
    cues = state.cues;
    setStatus("");
    startPolling();
    return;
  }
  if (state.state === "running") {
    if (state.total < runningHeld) {
      // The job was requeued and restarted: drop what is held, so the next poll asks from 0.
      dropRunning();
      changed = true;
    } else if (state.cues.length) {
      // rat-tail: running cues arrive unsorted and findCue binary-searches by start, so the whole list is re-sorted per answer; merge the sorted new slice if lists grow to many thousands.
      cues = cues.concat(state.cues).sort(compareCues);
      runningHeld += state.cues.length;
      changed = true;
    }
    setStatus(TRANSLATING);
    startPolling();
  } else if (state.state === "queued") {
    if (runningHeld) dropRunning();
    setStatus(WAITING);
  } else {
    // none, already_english and failed end the poll; failed drops its partial lines, as a reload would.
    runningHeld = 0;
    cues = [];
    stopPolling();
    showText("");
    setStatus(ENDED_LABELS[state.state]);
    return;
  }
  // Without a serving worker the state is shown but never polled.
  if (!state.available) return;
  stateDelay = changed ? STATE_POLL_FIRST_MS : Math.min(stateDelay * 2, STATE_POLL_MAX_MS);
  scheduleStatePoll(apiBase, video, ticket, stateDelay);
}

// One chain: each poll schedules the next only after its answer, and an answer from an earlier ticket schedules nothing.
function scheduleStatePoll(apiBase: string, video: TranslateVideo, ticket: number, delay: number) {
  clearStateTimer();
  stateTimer = setTimeout(() => {
    stateTimer = null;
    tracked(fetchTranslate(apiBase, video.id, video.host, runningHeld))
      .then((state) => (ticket === requestTicket ? applyFetched(state, apiBase, video, ticket) : undefined))
      .catch((error: unknown) => {
        if (ticket !== requestTicket) return;
        if (error instanceof ProfileKeyRejectedError) {
          setStatus(error.message);
          return;
        }
        // A network error, a 502 during a blue/green switch, a 429 or a malformed answer, to the poll or to its re-request, keeps the label and retries; neither call exposes the status.
        stateDelay = Math.min(stateDelay * 2, STATE_POLL_MAX_MS);
        scheduleStatePoll(apiBase, video, ticket, stateDelay);
      });
  }, delay);
}

function clearStateTimer() {
  if (stateTimer !== null) clearTimeout(stateTimer);
  stateTimer = null;
}

function resetStatePoll() {
  clearStateTimer();
  stateDelay = STATE_POLL_FIRST_MS;
  lastState = "";
  runningHeld = 0;
  cues = [];
}

function dropRunning() {
  runningHeld = 0;
  cues = [];
  showText("");
}

function startPolling() {
  stopPolling();
  pollTimer = setInterval(() => {
    if (!player || pollInFlight || Date.now() - lastUpdateAt < POLL_AFTER_SILENCE_MS) return;
    // rat-tail: getCurrentPosition has no timeout, so one call at a time; a call that never settles stops the fallback for this page, a per-call timeout if that is seen.
    pollInFlight = true;
    player.getCurrentPosition().then((position: unknown) => showAt(finiteNumber(position)), () => undefined).finally(() => { pollInFlight = false; });
  }, POLL_INTERVAL_MS);
}

function stopPolling() {
  if (pollTimer !== null) clearInterval(pollTimer);
  pollTimer = null;
}

function finiteNumber(value: unknown): number | null {
  return typeof value === "number" && Number.isFinite(value) ? value : null;
}

function showAt(position: number | null) {
  if (!on || position === null) return;
  showText(findCue(cues, position)?.text ?? "");
}

// Cue text is untrusted instance text: set with textContent only.
function showText(text: string) {
  if (!overlayEl) return;
  overlayEl.textContent = text;
  overlayEl.hidden = !text;
}

function renderToggle() {
  if (!toggleEl) return;
  toggleEl.setAttribute("aria-pressed", String(on));
  toggleEl.classList.toggle("active", on);
}

function setStatus(text: string) {
  if (statusEl) statusEl.textContent = text;
}
